# Core
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Prisma / Neon / Accelerate
# Use pooled connection strings (from Prisma Vercel Integration)
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DB?sslmode=require&pgbouncer=true"
PRISMA_ACCELERATE_URL="https://accelerate.prisma-data.net/PROJECT/ENV/ROUTE"

# Auth / Admin
NEXT_PUBLIC_ADMIN_KEY=

# Analytics / Monitoring
SENTRY_DSN=

# AI Providers
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Storage / Uploads
BLOB_READ_WRITE_TOKEN=